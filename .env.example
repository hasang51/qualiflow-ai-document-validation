APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg2://qualiflow:qualiflow@localhost:5432/qualiflow
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=local-dev-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=240

CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_UPLOAD=10/minute

OBJECT_STORAGE_BACKEND=s3
STORAGE_DIR=./data/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=qualiflow
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

EXTRACTION_PROVIDER=mock
BEDROCK_REGION=eu-central-1
BEDROCK_MODEL_ID=google.gemma-4-26b-a4b
BEDROCK_INPUT_COST_PER_MILLION=0.16
BEDROCK_OUTPUT_COST_PER_MILLION=0.48
BEDROCK_MAX_REQUEST_BYTES=3500000

PDF_DPI=400
POPPLER_PATH=
REVIEW_CONFIDENCE_THRESHOLD=0.75
MAX_UPLOAD_MB=20
WORKER_ENABLED=true
RQ_QUEUE_NAME=qualiflow
